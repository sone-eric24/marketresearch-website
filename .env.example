# Copy these into your host's environment variables (live server):
#   cPanel > Setup Python App > Environment variables, or Render > Environment.
# On Render most are already set by render.yaml (see DEPLOY.md).
# On your own computer you don't need any of them.

DJANGO_DEBUG=False
# Make a long random value, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=ws-marketresearch.com,www.ws-marketresearch.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ws-marketresearch.com,https://www.ws-marketresearch.com

# Contact form emails (use the email account you created in cPanel)
CONTACT_EMAIL=contact@ws-marketresearch.com
DEFAULT_FROM_EMAIL=contact@ws-marketresearch.com
EMAIL_HOST=mail.ws-marketresearch.com
EMAIL_PORT=465
EMAIL_HOST_USER=contact@ws-marketresearch.com
EMAIL_HOST_PASSWORD=your-email-password

# Where the database file and uploaded images are kept. Only needed on hosts
# that wipe the code folder at each deploy (Render, Docker). Defaults: the project folder.
# DJANGO_DB_PATH=/var/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/data/media

# Creates your admin login automatically the first time the site starts (optional).
# DJANGO_SUPERUSER_USERNAME=eric
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=a-long-strong-password
