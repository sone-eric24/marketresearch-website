# Copy these into cPanel > Setup Python App > Environment variables (live server).
# On your own computer you don't need any of them.

DJANGO_DEBUG=False
# Make a long random value, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=ws-marketresearch.com,www.ws-marketresearch.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://ws-marketresearch.com,https://www.ws-marketresearch.com

# Contact form emails (use the email account you created in cPanel)
CONTACT_EMAIL=contact@ws-marketresearch.com
DEFAULT_FROM_EMAIL=contact@ws-marketresearch.com
EMAIL_HOST=mail.ws-marketresearch.com
EMAIL_PORT=465
EMAIL_HOST_USER=contact@ws-marketresearch.com
EMAIL_HOST_PASSWORD=your-email-password
